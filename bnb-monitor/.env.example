# Copiare in .env e compilare. Il file .env non va condiviso né messo su git.
POSTGRES_DB=bnb
POSTGRES_USER=bnb
POSTGRES_PASSWORD=cambia-questa-password

# Bot Telegram personale (da @BotFather) e identificativo della chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Porta della dashboard nel browser di casa: http://<pc-o-nas>:8501
DASHBOARD_PORT=8501
